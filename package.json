{
  "name": "greenlight",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,sql,yml,yaml}\""
  },
  "devDependencies": {
    "@greenlight/config": "workspace:*",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.1",
    "prettier": "^3.5.3",
    "turbo": "^2.5.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
